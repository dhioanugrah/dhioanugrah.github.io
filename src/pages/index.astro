---
import "../styles/global.css";

const githubUrl = "https://github.com/dhioanugrah";

import { projects } from "../data/projects.js";

const featuredProjects = projects.filter((p) => p.featured);
const mobileProjects = projects.filter((p) => p.category === "Mobile");
const otherProjects = projects.filter(
  (p) => !p.featured && p.category !== "Mobile",
);

const backgroundItems = [
  {
    number: "01",
    title: "Pendidikan",
    text: "S1 Informatika, Institut Teknologi Kalimantan. Seluruh persyaratan akademik telah diselesaikan dan saat ini menunggu yudisium serta wisuda.",
  },
  {
    number: "02",
    title: "Sertifikasi",
    text: "Memiliki sertifikasi kompetensi Web Development dari Badan Nasional Sertifikasi Profesi sebagai pengakuan kemampuan dasar pengembangan aplikasi terstruktur.",
  },
  {
    number: "03",
    title: "Pencapaian SMK",
    text: "Meraih Juara 3 LKS tingkat provinsi bidang Teknik Desain Laman dan medapatkan nilai UKK terbaik Ke 3 sekolah dengan nilai 95 dari 100.",
  },
];

const rawSkills = projects.flatMap((p) => p.tech || []);
const uniqueSkills = [...new Set(rawSkills.map((skill) => skill.trim()))];
const skills = uniqueSkills.sort((a, b) =>
  a.toLowerCase().localeCompare(b.toLowerCase()),
);

const certificates = [
  {
    id: "bnsp",
    title: "Sertifikasi BNSP",
    subtitle: "Badan Nasional Sertifikasi Profesi - Web Developer",
    cover: "/projects/sertif/bnsp/sertifikat_bnsp_web-3_page-0001.jpg",
  },
  {
    id: "hki",
    title: "Hak Kekayaan Intelektual",
    subtitle: "Karya Cipta Program Komputer",
    cover: "/projects/sertif/hki web/sertifikat_HKI_Web kkn-2_page-0001.jpg",
  },
  {
    id: "hki-game",
    title: "Hak Kekayaan Intelektual",
    subtitle: "Karya Cipta Program Komputer (Game)",
    cover: "/projects/sertif/haki game/sertifikat_HKI_Game-1_page-0001.jpg",
  }
];
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Portfolio Dhio Anugrah Prakasa Putro — Fullstack Developer."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("dhio-theme");

        const theme =
          savedTheme === "light" || savedTheme === "dark" ? savedTheme : "dark";

        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <title>Dhio Anugrah — Fullstack Developer</title>
  </head>

  <body>
    <!-- LOADING SCREEN -->
    <div id="loading-screen">
      <div class="pixel-corner pixel-corner-tl"></div>
      <div class="pixel-corner pixel-corner-tr"></div>
      <div class="pixel-corner pixel-corner-bl"></div>
      <div class="pixel-corner pixel-corner-br"></div>
      
      <div class="loading-text">
        <span>Memuat</span>
        <span id="loading-progress">0%</span>
      </div>
      <div class="pixel-bar-container">
        <div id="pixel-bar" class="pixel-bar-fill"></div>
      </div>
    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const loader = document.getElementById("loading-screen");
        if (!loader) return;
        const bar = document.getElementById("pixel-bar");
        const progressText = document.getElementById("loading-progress");
        
        // Hanya tampilkan pertama kali di sesi ini
        if (sessionStorage.getItem("hasLoadedPortfolio")) {
          loader.style.display = "none";
          return;
        }
        
        let progress = 0;
        const interval = setInterval(() => {
          progress += Math.floor(Math.random() * 15) + 10;
          if (progress >= 100) {
            progress = 100;
            clearInterval(interval);
            setTimeout(() => {
              loader.classList.add("hidden");
              sessionStorage.setItem("hasLoadedPortfolio", "true");
              setTimeout(() => loader.remove(), 1000);
            }, 400);
          }
          bar.style.width = `${progress}%`;
          progressText.innerText = `${progress}%`;
        }, 120);
      });
    </script>
    <header class="fixed inset-x-0 top-4 z-50 px-4 will-change-transform transform-gpu">
      <div
        class="nav-shell mx-auto flex w-full max-w-[1440px] items-center justify-between rounded-full px-4 py-3 md:px-6 lg:py-4 relative z-[60]"
      >
        <a
          href="#beranda"
          class="font-mono text-sm font-medium tracking-tight shrink-0"
        >
          DHIO<span class="text-accent">.</span>
        </a>

        <!-- Desktop Nav -->
        <nav
          class="hidden items-center gap-1 md:flex"
          aria-label="Navigasi utama"
        >
          <a href="#beranda" class="nav-link is-active">Beranda</a>
          <a href="#project" class="nav-link">Project</a>
          <a href="#riset" class="nav-link">Riset</a>
          <a href="#sertifikat" class="nav-link">Sertifikat</a>
          <a href="#latar" class="nav-link">Profil</a>
          <a href="#kontak" class="nav-link">Kontak</a>
        </nav>

        <!-- Right Side -->
        <div class="flex items-center gap-2 shrink-0">
          <a
            href="https://github.com/dhioanugrah"
            target="_blank"
            rel="noreferrer"
            class="nav-github hidden md:block"
          >
            GitHub ↗
          </a>

          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Ubah tema"
            title="Ubah tema"
          >
            <svg
              class="theme-icon theme-icon-moon"
              xmlns="http://www.w3.org/2000/svg"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 3a6.5 6.5 0 0 0 9 9A9 9 0 1 1 12 3z"></path>
            </svg>
            <svg
              class="theme-icon theme-icon-sun"
              xmlns="http://www.w3.org/2000/svg"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
          </button>

          <!-- Hamburger Button -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="md:hidden flex flex-col justify-center gap-[4px] w-8 h-8 items-center rounded-full bg-transparent border border-nav-border"
            aria-label="Menu"
          >
            <span
              class="w-3.5 h-[1.5px] bg-nav-fg transition-transform duration-300"
            ></span>
            <span
              class="w-3.5 h-[1.5px] bg-nav-fg transition-transform duration-300"
            ></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Menu Overlay -->
    <div
      id="mobile-menu-overlay"
      class="fixed inset-0 z-50 bg-paper/95 backdrop-blur-md flex flex-col justify-center items-center gap-6 opacity-0 invisible pointer-events-none transition-all duration-300 md:hidden"
    >
      <nav
        class="flex flex-col items-center gap-6 text-xl font-serif"
        aria-label="Navigasi mobile"
      >
        <a href="#beranda" class="nav-link">Beranda</a>
        <a href="#project" class="nav-link">Project</a>
        <a href="#riset" class="nav-link">Riset</a>
        <a href="#sertifikat" class="nav-link">Sertifikat</a>
        <a href="#latar" class="nav-link">Profil</a>
        <a href="#kontak" class="nav-link">Kontak</a>
      </nav>
      <div class="mt-8">
        <a
          href="https://github.com/dhioanugrah"
          target="_blank"
          rel="noreferrer"
          class="font-mono text-xs border border-line px-5 py-2.5 rounded-full transition hover:bg-ink hover:text-paper"
        >
          GitHub ↗
        </a>
      </div>
    </div>

    <div class="overflow-x-hidden w-full">
      <main class="pt-20 md:pt-28">
        <!-- HERO -->
        <section id="beranda" class="container-main pt-10 pb-16 md:py-24">
          <div
            class="grid grid-cols-1 gap-10 md:gap-12 md:grid-cols-[0.38fr_0.62fr] md:items-center lg:gap-20"
          >
            <div
              class="order-2 mx-auto w-[85%] max-w-[320px] md:mx-0 md:w-full md:max-w-none md:order-none gsap-hero-reveal relative"
            >
              <!-- Subtle glow behind the image -->
              <div
                class="absolute inset-0 bg-accent/20 blur-3xl rounded-full translate-y-1/4 scale-90 -z-10 will-change-transform transform-gpu"
              >
              </div>

              <div
                class="overflow-hidden rounded-[20px] border border-line bg-paper relative"
              >
                <img
                  src="/profile/dhio-profile.webp"
                  alt="Foto profil Dhio Anugrah"
                  class="w-full h-auto"
                  onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden')"
                />

                <div
                  class="absolute inset-0 hidden items-center justify-center bg-ink text-paper"
                >
                  <div class="text-center">
                    <div
                      class="mx-auto mb-4 flex h-24 w-24 items-center justify-center rounded-2xl border border-line bg-paper/5 text-sm font-mono uppercase tracking-[0.18em] text-muted"
                    >
                      Foto Profil
                    </div>
                    <p
                      class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted"
                    >
                      Placeholder lokal
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="order-1 max-w-3xl md:order-none md:pl-4">
              <p class="label mb-4 md:mb-6 text-accent">
                Fullstack Developer · INDONESIA
              </p>

              <h1
                class="max-w-3xl text-4xl sm:text-5xl font-serif font-medium leading-[1.1] md:leading-[1.05] tracking-[-0.05em] md:text-6xl lg:text-7xl xl:text-[5.5rem] gsap-hero-reveal"
              >
                Halo, saya Dhio Anugrah.
              </h1>

              <p
                class="mt-6 md:mt-8 max-w-2xl text-[1.05rem] leading-relaxed text-muted md:text-xl lg:text-2xl gsap-hero-reveal"
              >
                Fullstack Developer yang berspesialisasi dalam mendigitalisasi
                proses bisnis operasional melalui sistem yang terintegrasi dan
                terukur.
              </p>

              <p
                class="mt-4 md:mt-5 max-w-2xl text-[0.95rem] leading-relaxed text-muted md:text-[1.02rem]"
              >
                Berpengalaman dalam membangun sistem ERP, Warehouse Management,
                dan arsitektur REST API secara <i>end-to-end</i> menggunakan ekosistem
                Laravel. Mampu mengintegrasikan layanan <i>backend</i> yang solid
                dengan antarmuka <i>website</i> maupun aplikasi <i>mobile</i> berbasis
                Flutter.
              </p>

              <div
                class="mt-6 md:mt-7 w-full marquee-container gsap-hero-reveal"
              >
                <div class="marquee-content">
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >Laravel</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >PHP</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >MySQL</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >REST API</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >Tailwind CSS</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >Flutter</span
                  >
                </div>
                <div class="marquee-content" aria-hidden="true">
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >Laravel</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >PHP</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >MySQL</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >REST API</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >Tailwind CSS</span
                  >
                  <span
                    class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
                    >Flutter</span
                  >
                </div>
              </div>

              <div class="mt-8 md:mt-10 flex flex-wrap gap-3">
                <a
                  href="#project"
                  class="bg-ink px-5 py-3 font-mono text-xs text-paper transition hover:bg-accent"
                >
                  Lihat Project ↓
                </a>

                <a
                  href="mailto:dhioanugrahh@gmail.com"
                  class="border border-line px-5 py-3 font-mono text-xs transition hover:border-accent hover:text-accent"
                >
                  Hubungi Saya ↗
                </a>

                <button
                  onclick="openCvModal()"
                  class="border border-line px-5 py-3 font-mono text-xs transition hover:border-accent hover:text-accent"
                >
                  Lihat CV ↗
                </button>
              </div>
            </div>
          </div>
          <div
            class="mt-12 md:mt-16 grid grid-cols-1 gap-5 md:gap-6 border-t border-line pt-6 md:grid-cols-3"
          >
            <div>
              <p class="label">Fokus</p>
              <p class="mt-2 text-sm">Digitalisasi Bisnis & Pengembangan API</p>
            </div>

            <div>
              <p class="label">Teknologi Utama</p>
              <p class="mt-2 text-sm">Laravel · Flutter · MySQL</p>
            </div>

            <div>
              <p class="label">Domisili Sekarang</p>
              <p class="mt-2 text-sm">Surabaya, Indonesia</p>
            </div>
          </div>
        </section>

        <!-- FEATURED PROJECTS -->
        <section id="project" class="section-line">
          <div class="container-main py-20 md:py-28">
            <div
              class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end"
            >
              <div>
                <p class="label">01 / Project Unggulan</p>

                <h2
                  class="mt-4 text-4xl sm:text-5xl font-serif font-medium tracking-[-0.05em] md:text-6xl lg:text-[4.5rem] lg:leading-[1.1] gsap-section-title"
                >
                  Sistem yang saya bantu bangun.
                </h2>
              </div>

              <div class="max-w-sm">
                <p class="text-sm leading-relaxed text-muted">
                  Setiap project menjelaskan kebutuhan yang diselesaikan,
                  konteks organisasi, peran saya, dan teknologi yang digunakan.
                </p>
                <a
                  href="/projects"
                  class="mt-6 inline-flex items-center gap-2 border-b border-ink pb-1 font-mono text-xs uppercase tracking-widest text-ink transition hover:text-accent hover:border-accent"
                >
                  Lihat Semua Project ↗
                </a>
              </div>
            </div>

            <div class="space-y-16">
              {
                featuredProjects.map((project) => (
                  <article class="group grid grid-cols-1 gap-7 border-t border-line pt-6 md:grid-cols-[0.18fr_1fr_1fr] gsap-project-reveal">
                    <div>
                      <p class="font-mono text-sm text-accent">
                        {project.number}
                      </p>

                      <p class="mt-3 font-mono text-xs text-muted">
                        {project.context}
                      </p>
                    </div>

                    <div>
                      <p class="label">{project.client}</p>

                      <h3 class="mt-4 text-2xl font-serif font-medium leading-tight tracking-[-0.04em] md:text-4xl">
                        {project.title}
                      </h3>

                      <p class="mt-5 max-w-xl leading-relaxed text-muted">
                        {project.description}
                      </p>

                      <div class="mt-6">
                        <p class="label">Kontribusi Saya</p>
                        <p class="mt-2 max-w-xl text-sm leading-relaxed">
                          {project.role}
                        </p>
                      </div>

                      <div class="mt-6 flex flex-wrap gap-2">
                        {project.tech.map((item) => (
                          <span class="border border-line px-3 py-1 font-mono text-[0.68rem]">
                            {item}
                          </span>
                        ))}
                      </div>

                      {project.links && (
                        <div class="mt-7 flex flex-wrap gap-3">
                          <a
                            href={`/projects/${project.slug}`}
                            class="inline-flex items-center rounded-full bg-ink px-4 py-2 font-mono text-xs text-paper transition hover:bg-accent"
                          >
                            Lihat Detail ↗
                          </a>
                          {project.links.map((link) => (
                            <a
                              href={link.href}
                              target="_blank"
                              rel="noreferrer"
                              class="inline-flex items-center rounded-full border border-ink px-4 py-2 font-mono text-xs text-ink transition hover:bg-ink hover:text-paper"
                            >
                              {link.label} ↗
                            </a>
                          ))}
                        </div>
                      )}
                      {!project.links && (
                        <div class="mt-7 flex flex-wrap gap-3">
                          <a
                            href={`/projects/${project.slug}`}
                            class="inline-flex items-center rounded-full bg-ink px-4 py-2 font-mono text-xs text-paper transition hover:bg-accent"
                          >
                            Lihat Detail ↗
                          </a>
                        </div>
                      )}
                    </div>

                    <a
                      href={`/projects/${project.slug}`}
                      class="self-start overflow-hidden rounded-2xl border border-line bg-paper transition duration-700 md:group-hover:-translate-y-2 md:group-hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.15)] md:group-hover:border-accent/40"
                    >
                      <img
                        src={project.image}
                        alt={project.title}
                        class="block aspect-[4/3] w-full object-cover transition duration-700 md:group-hover:scale-[1.05] md:group-hover:-rotate-1"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <!-- OTHER PROJECTS -->
        <section class="section-line overflow-hidden relative">
          <div class="container-main py-20 md:py-28">
            <div class="max-w-2xl mb-16" data-aos="fade-up">
              <p class="label">02 / Project Lainnya</p>
              <h2
                class="mt-4 text-3xl font-medium tracking-[-0.05em] md:text-5xl"
              >
                Pengalaman di berbagai Industri.
              </h2>
            </div>

            <div
              class="w-full marquee-container"
              data-aos="fade-up"
              data-aos-delay="100"
            >
              <div
                class="marquee-content items-stretch"
                style="animation-duration: 40s; gap: 1.5rem;"
              >
                {
                  otherProjects.map((project, index) => (
                    <article class="group w-[320px] md:w-[380px] flex-shrink-0 flex flex-col justify-between rounded-[2rem] border border-line bg-[#111] p-6 md:p-8 transition-all duration-500 hover:border-accent hover:bg-ink">
                      <div>
                        <p class="font-mono text-xs text-accent">
                          0{index + 1}
                        </p>

                        {project.image && (
                          <div class="mt-5 mb-2 overflow-hidden rounded-[1rem] bg-[#1a1a1a] h-32 w-full">
                            <img
                              src={project.image}
                              alt={project.title}
                              class="h-full w-full object-cover opacity-70 transition duration-500 hover:opacity-100 hover:scale-105"
                              loading="lazy"
                              decoding="async"
                            />
                          </div>
                        )}

                        <h3 class="mt-4 text-xl md:text-2xl font-medium tracking-tight line-clamp-2 text-white group-hover:text-paper transition-colors duration-500">
                          {project.title}
                        </h3>
                        <p class="mt-2 font-mono text-[0.65rem] uppercase tracking-widest text-muted">
                          {project.context}
                        </p>
                        <p class="mt-5 text-sm leading-relaxed text-muted line-clamp-3">
                          {project.description}
                        </p>
                      </div>
                      <div class="mt-8">
                        <div class="flex flex-wrap gap-2 mb-6">
                          {project.tech.slice(0, 3).map((item) => (
                            <span class="border border-line px-3 py-1 font-mono text-[0.65rem] rounded-full text-muted">
                              {item}
                            </span>
                          ))}
                          {project.tech.length > 3 && (
                            <span class="border border-line px-3 py-1 font-mono text-[0.65rem] rounded-full text-muted">
                              +{project.tech.length - 3}
                            </span>
                          )}
                        </div>
                        <a
                          href={`/projects/${project.slug}`}
                          class="inline-flex items-center rounded-full bg-paper px-5 py-2.5 font-mono text-xs text-ink transition hover:bg-accent hover:text-white w-full justify-center"
                        >
                          Lihat Detail ↗
                        </a>
                      </div>
                    </article>
                  ))
                }
              </div>

              <!-- Clone for infinite loop -->
              <div
                class="marquee-content items-stretch"
                aria-hidden="true"
                style="animation-duration: 40s; gap: 1.5rem;"
              >
                {
                  otherProjects.map((project, index) => (
                    <article class="group w-[320px] md:w-[380px] flex-shrink-0 flex flex-col justify-between rounded-[2rem] border border-line bg-[#111] p-6 md:p-8 transition-all duration-500 hover:border-accent hover:bg-ink">
                      <div>
                        <p class="font-mono text-xs text-accent">
                          0{index + 1}
                        </p>

                        {project.image && (
                          <div class="mt-5 mb-2 overflow-hidden rounded-[1rem] bg-[#1a1a1a] h-32 w-full">
                            <img
                              src={project.image}
                              alt={project.title}
                              class="h-full w-full object-cover opacity-70 transition duration-500 hover:opacity-100 hover:scale-105"
                            />
                          </div>
                        )}

                        <h3 class="mt-4 text-xl md:text-2xl font-medium tracking-tight line-clamp-2 text-white group-hover:text-paper transition-colors duration-500">
                          {project.title}
                        </h3>
                        <p class="mt-2 font-mono text-[0.65rem] uppercase tracking-widest text-muted">
