---
import "../styles/global.css";

const githubUrl = "https://github.com/dhioanugrah";

const featuredProjects = [
  {
    number: "01",
    title: "Digitalisasi Operasional Layanan Kebersihan Multi-Cabang - ERP",
    client: "Klinklin Surabaya",
    context: "Fullstack Developer · Juni 2026 — Juli 2026",
    description:
      "ERP PT Klinklin Surabaya yang terintegrasi mobile dan website melalui 1 API.",
    role: "Membangun API untuk digunakan di web dan mobile dan membangun tampilan website.",
    tech: ["Laravel", "MySQL", "REST API", "Laravel Queue", "Postman"],
    image: "/projects/klinklin-cover.webp",
    links: [{ label: "GitHub", href: githubUrl }],
  },
  {
    number: "02",
    title: "Sistem Pengelolaan Stok dan Produk untuk Operasional Gudang",
    client: "PT Hidrolik Indomitra Teknologi",
    context: "Project Manager & Backend Developer · Magang 3 Bulan · 2025",
    description:
      "Mengembangkan Warehouse Management System untuk membantu pengelolaan produk dan stok, sekaligus memastikan alur pengerjaan tim berjalan terarah.",
    role: "Mengembangkan backend sistem menggunakan Laravel dan Filament, mengatur workflow pengembangan, serta mengoordinasikan pengerjaan tim selama proyek berlangsung.",
    tech: ["Laravel", "Filament", "MySQL", "PHP", "Git"],
    image: "/projects/warehouse-cover.webp",
    links: [
      {
        label: "Repository GitHub",
        href: "https://github.com/dhioanugrah/final-kp",
      },
    ],
  },
  {
    number: "03",
    title: "Sistem Informasi Penerimaan Mahasiswa Jalur Mandiri",
    client: "Summit ITK",
    context:
      "Backend Developer · Project Kolaboratif Bersama Dosen · 2023 — 2024",
    description:
      "Berkontribusi dalam pengembangan sistem informasi penerimaan mahasiswa jalur mandiri untuk mendukung kebutuhan platform Summit Institut Teknologi Kalimantan.",
    role: "Membantu pengembangan fitur backend, struktur data, dan integrasi sistem dalam tim berbasis Laravel.",
    tech: ["Laravel", "PHP", "MySQL", "Git"],
    image: "/projects/summit-itk-cover.webp",
    links: [{ label: "Kunjungi", href: "https://summit.itk.ac.id/" }],
  },
  {
    number: "04",
    title: "Backend Pengelolaan Pelanggan dan Pesanan Cuci Sepatu",
    client: "Shoe Washing Management System",
    context: "REST API Project · Agustus — November 2024",
    description:
      "Membangun API untuk mengelola data pelanggan dan pesanan pada layanan cuci sepatu dengan perhatian pada konsistensi serta efisiensi pengolahan data.",
    role: "Membuat REST API, melakukan pengujian endpoint melalui Postman, serta memanfaatkan function, trigger, dan view untuk mendukung integritas database.",
    tech: [
      "JavaScript",
      "MVC",
      "MySQL",
      "REST API",
      "Database Trigger",
      "Postman",
    ],
    image: "/projects/ERD.png",
    links: [
      {
        label: "Repository GitHub",
        href: "https://github.com/dhioanugrah/mbd/tree/main",
      },
    ],
  },
];

const mobileProjects = [
  {
    title: "Aplikasi Panduan Digital Kebun Raya Balikpapan",
    client: "Botanical Garden Journal",
    context: "Fullstack Mobile Developer · Agustus — Desember 2025",
    description:
      "Membangun aplikasi Flutter yang terhubung ke Laravel API untuk membantu pengunjung mengakses informasi saat berada di Kebun Raya Balikpapan.",
    tech: ["Flutter", "Dart", "Drift", "GoRoute"],
    image: "/projects/botanical-mobile.webp",
    links: [
      {
        label: "Repository GitHub",
        href: "https://github.com/dhioanugrah/Mobile_KRB",
      },
    ],
  },
  {
    title: "Aplikasi Mobile Katalog Produk Sepatu",
    client: "Shoe Store",
    context: "Fullstack Mobile Developer · Maret — Juni 2025",
    description:
      "Membangun aplikasi mobile untuk menampilkan katalog dan informasi produk sepatu melalui integrasi Flutter dengan Laravel API.",
    tech: ["Flutter", "Dart", "Drift", "GoRoute"],
    image: "/projects/shoe-store-mobile.webp",
  },
];

const otherProjects = [
  {
    title: "KaltimFact",
    context: "Backend Developer · Agency Project · Juni 2025 — Sekarang",
    description:
      "Mengembangkan dan melakukan pemeliharaan project digital untuk kebutuhan klien PT Berkat Doa Kaltim.",
    tech: ["Laravel", "Backend Development", "Maintenance"],
    links: [{ label: "Kunjungi", href: "https://www.kaltimfact.com/" }],
  },
  {
    title: "Backend Online Learning Platform",
    context: "Backend Developer · Agustus — November 2024",
    description:
      "Membangun backend dan API untuk komunikasi antara aplikasi pembelajaran online dengan frontend serta menguji endpoint menggunakan Postman.",
    tech: ["REST API", "Postman", "Backend Development"],
  },
  {
    title: "Website Wisata Mangrove Margomulyo",
    context: "Fullstack Developer · Maret — Juni 2025",
    description:
      "Membangun website informasi wisata mangrove Margomulyo untuk mendukung penyampaian informasi kepada pengunjung.",
    tech: ["Laravel", "Web Development", "Database"],
    links: [
      {
        label: "Repository GitHub",
        href: "https://github.com/dhioanugrah/kkn",
      },
    ],
  },
  {
    title: "E-Commerce Terintegrasi AI",
    context: "Fullstack Developer · November 2025",
    description:
      "Membangun e-commerce dengan Laravel sebagai backend, Vue.js sebagai frontend, serta integrasi model Hugging Face untuk analisis rating produk.",
    tech: ["Laravel", "Vue.js", "Hugging Face", "AI Integration"],
    links: [
      {
        label: "Repository GitHub",
        href: "https://github.com/dhioanugrah/toko_elektronik_AI",
      },
    ],
  },
];

const backgroundItems = [
  {
    number: "01",
    title: "Pendidikan",
    text: "S1 Informatika, Institut Teknologi Kalimantan. Seluruh persyaratan akademik telah diselesaikan dan saat ini menunggu yudisium serta wisuda.",
  },
  {
    number: "02",
    title: "Sertifikasi",
    text: "Memiliki sertifikasi kompetensi Web Development dari Badan Nasional Sertifikasi Profesi sebagai pengakuan kemampuan dasar pengembangan aplikasi terstruktur.",
  },
  {
    number: "03",
    title: "Pencapaian SMK",
    text: "Meraih Juara 3 LKS tingkat provinsi bidang Teknik Desain Laman dan medapatkan nilai UKK terbaik Ke 3 sekolah dengan nilai 95 dari 100.",
  },
];

const skills = [
  "Laravel",
  "PHP",
  "MySQL",
  "REST API",
  "Database Design",
  "Laravel Sanctum",
  "Laravel Queue",
  "Filament",
  "Git",
  "Postman",
  "Flutter",
  "TensorFlow",
];
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Portfolio Dhio Anugrah Prakasa Putro — Backend Developer."
    />

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("dhio-theme");

        const theme =
          savedTheme === "light" || savedTheme === "dark" ? savedTheme : "dark";

        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <title>Dhio Anugrah — Backend Developer</title>
  </head>

  <body>
    <header class="fixed inset-x-0 top-4 z-50 px-4">
      <div
        class="nav-shell mx-auto flex w-full max-w-6xl items-center justify-between rounded-full px-4 py-3 md:px-5"
      >
        <a href="#beranda" class="font-mono text-sm font-medium tracking-tight">
          DHIO<span class="text-accent">.</span>
        </a>

        <nav
          class="hidden items-center gap-1 md:flex"
          aria-label="Navigasi utama"
        >
          <a href="#beranda" class="nav-link is-active">Beranda</a>
          <a href="#project" class="nav-link">Project</a>
          <a href="#riset" class="nav-link">Riset</a>
          <a href="#mobile" class="nav-link">Mobile</a>
          <a href="#latar" class="nav-link">Profil</a>
          <a href="#kontak" class="nav-link">Kontak</a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="https://github.com/dhioanugrah"
            target="_blank"
            rel="noreferrer"
            class="nav-github"
          >
            GitHub ↗
          </a>

          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Ubah tema"
            title="Ubah tema"
          >
            <svg
              class="theme-icon theme-icon-moon"
              xmlns="http://www.w3.org/2000/svg"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 3a6.5 6.5 0 0 0 9 9A9 9 0 1 1 12 3z"></path>
            </svg>

            <svg
              class="theme-icon theme-icon-sun"
              xmlns="http://www.w3.org/2000/svg"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="pt-24 md:pt-28">
      <!-- HERO -->
      <section id="beranda" class="container-main py-16 md:py-24">
        <div
          class="grid gap-10 md:grid-cols-[0.4fr_0.6fr] md:items-center md:gap-14"
        >
          <div class="order-1 md:order-none">
            <div
              class="overflow-hidden rounded-[20px] border border-line bg-paper"
            >
              <div class="relative aspect-[4/5] w-full">
                <img
                  src="/profile/dhio-profile.webp"
                  alt="Foto profil Dhio Anugrah"
                  class="absolute inset-0 h-full w-full object-cover"
                  onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden')"
                />

                <div
                  class="absolute inset-0 hidden items-center justify-center bg-ink text-paper"
                >
                  <div class="text-center">
                    <div
                      class="mx-auto mb-4 flex h-24 w-24 items-center justify-center rounded-2xl border border-line bg-paper/5 text-sm font-mono uppercase tracking-[0.18em] text-muted"
                    >
                      Foto Profil
                    </div>
                    <p
                      class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted"
                    >
                      Placeholder lokal
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="order-2 max-w-3xl md:order-none md:pl-4">
            <p class="label mb-6 text-accent">BACKEND DEVELOPER · INDONESIA</p>

            <h1
              class="max-w-2xl text-4xl font-medium leading-tight tracking-[-0.05em] md:text-5xl"
            >
              Halo, saya Dhio Anugrah.
            </h1>

            <p
              class="mt-6 max-w-2xl text-lg leading-relaxed text-muted md:text-xl"
            >
              Backend Developer yang membangun sistem terintegrasi untuk
              membantu proses bisnis berjalan lebih rapi dan terukur.
            </p>

            <p
              class="mt-5 max-w-2xl leading-relaxed text-muted md:text-[1.02rem]"
            >
              Saya berfokus pada pengembangan REST API, database relasional,
              alur proses bisnis, dan integrasi backend untuk website maupun
              aplikasi mobile.
            </p>

            <div class="mt-7 flex flex-wrap gap-2">
              <span
                class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
              >
                Laravel &amp; PHP
              </span>
              <span
                class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
              >
                REST API &amp; Database
              </span>
              <span
                class="rounded-full border border-line px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted"
              >
                MySQL &amp; System Integration
              </span>
            </div>

            <div class="mt-10 flex flex-wrap gap-3">
              <a
                href="#project"
                class="bg-ink px-5 py-3 font-mono text-xs text-paper transition hover:bg-accent"
              >
                Lihat Project ↓
              </a>

              <a
                href="mailto:dhioanugrahh@gmail.com"
                class="border border-line px-5 py-3 font-mono text-xs transition hover:border-accent hover:text-accent"
              >
                Hubungi Saya ↗
              </a>
            </div>
          </div>
        </div>
        <div
          class="mt-14 grid gap-6 border-t border-line pt-6 md:mt-16 md:grid-cols-3"
        >
          <div>
            <p class="label">Fokus</p>
            <p class="mt-2 text-sm">Backend System & REST API</p>
          </div>

          <div>
            <p class="label">Teknologi Utama</p>
            <p class="mt-2 text-sm">Laravel · MySQL · PHP</p>
          </div>

          <div>
            <p class="label">Domisili</p>
            <p class="mt-2 text-sm">Balikpapan, Indonesia</p>
          </div>
        </div>
      </section>

      <!-- FEATURED PROJECTS -->
      <section id="project" class="section-line">
        <div class="container-main py-20 md:py-28">
          <div
            class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end"
          >
            <div>
              <p class="label">01 / Project Unggulan</p>

              <h2
                class="mt-4 text-4xl font-medium tracking-[-0.05em] md:text-6xl"
              >
                Sistem yang saya bantu bangun.
              </h2>
            </div>

            <p class="max-w-sm text-sm leading-relaxed text-muted">
              Setiap project menjelaskan kebutuhan yang diselesaikan, konteks
              organisasi, peran saya, dan teknologi yang digunakan.
            </p>
          </div>

          <div class="space-y-16">
            {
              featuredProjects.map((project) => (
                <article class="grid gap-7 border-t border-line pt-6 md:grid-cols-[0.18fr_1fr_1fr]">
                  <div>
                    <p class="font-mono text-sm text-accent">
                      {project.number}
                    </p>

                    <p class="mt-3 font-mono text-xs text-muted">
                      {project.context}
                    </p>
                  </div>

                  <div>
                    <p class="label">{project.client}</p>

                    <h3 class="mt-4 text-2xl font-medium leading-tight tracking-[-0.04em] md:text-4xl">
                      {project.title}
                    </h3>

                    <p class="mt-5 max-w-xl leading-relaxed text-muted">
                      {project.description}
                    </p>

                    <div class="mt-6">
                      <p class="label">Kontribusi Saya</p>
                      <p class="mt-2 max-w-xl text-sm leading-relaxed">
                        {project.role}
                      </p>
                    </div>

                    <div class="mt-6 flex flex-wrap gap-2">
                      {project.tech.map((item) => (
                        <span class="border border-line px-3 py-1 font-mono text-[0.68rem]">
                          {item}
                        </span>
                      ))}
                    </div>

                    {project.links && (
                      <div class="mt-7 flex flex-wrap gap-3">
                        {project.links.map((link) => (
                          <a
                            href={link.href}
                            target="_blank"
                            rel="noreferrer"
                            class="inline-flex items-center rounded-full border border-ink px-4 py-2 font-mono text-xs text-ink transition hover:bg-ink hover:text-paper"
                          >
                            {link.label} ↗
                          </a>
                        ))}
                      </div>
                    )}
                  </div>

                  <div class="self-start overflow-hidden rounded-2xl border border-line bg-paper">
                    <img
                      src={project.image}
                      alt={project.title}
                      class="block aspect-[4/3] w-full object-contain transition duration-500 md:hover:scale-[1.02]"
                    />
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- RESEARCH -->
      <section id="riset" class="research-section">
        <div class="container-main py-20 md:py-28">
          <div class="grid gap-12 md:grid-cols-[0.45fr_1fr]">
            <p
              class="research-accent font-mono text-xs uppercase tracking-[0.12em]"
            >
              02 / Research Highlight
            </p>

            <div>
              <p class="research-accent font-mono text-xs">
                Tugas Akhir · Deep Learning
              </p>

              <h2
                class="mt-5 max-w-4xl text-4xl font-medium leading-[0.95] tracking-[-0.05em] md:text-6xl"
              >
                Klasifikasi Flora Endemik Kalimantan Menggunakan EfficientNetV2.
              </h2>

              <p class="research-muted mt-8 max-w-2xl leading-relaxed">
                Penelitian klasifikasi 28 spesies flora endemik Kalimantan
                menggunakan 2.800 citra digital yang dikumpulkan di Kebun Raya
                Balikpapan. Pengujian dilakukan pada EfficientNetV2-S,
                EfficientNetV2-M, dan EfficientNetV2-L.
              </p>

              <div class="research-metrics mt-12 grid gap-px md:grid-cols-4">
                <div class="research-metric p-6">
                  <p class="research-accent font-mono text-3xl">2.800</p>
                  <p class="research-muted mt-2 font-mono text-xs">
                    Citra Dataset
                  </p>
                </div>

                <div class="research-metric p-6">
                  <p class="research-accent font-mono text-3xl">28</p>
                  <p class="research-muted mt-2 font-mono text-xs">
                    Spesies Flora
                  </p>
                </div>

                <div class="research-metric p-6">
                  <p class="research-accent font-mono text-3xl">97,58%</p>
                  <p class="research-muted mt-2 font-mono text-xs">
                    Akurasi Terbaik
                  </p>
                </div>

                <div class="research-metric p-6">
                  <p class="research-accent font-mono text-3xl">97,59%</p>
                  <p class="research-muted mt-2 font-mono text-xs">
                    F1-Score Terbaik
                  </p>
                </div>
              </div>

              <p class="research-muted mt-8 max-w-2xl text-sm leading-relaxed">
                EfficientNetV2-L menghasilkan performa klasifikasi terbaik,
                sedangkan EfficientNetV2-S memberikan waktu inferensi paling
                cepat untuk kebutuhan yang lebih responsif.
              </p>

              <div class="mt-10 flex flex-wrap gap-2">
                {
                  [
                    "Python",
                    "TensorFlow",
                    "EfficientNetV2",
                    "Google Colab",
                    "Computer Vision",
                  ].map((item) => (
                    <span class="research-tag px-3 py-1 font-mono text-[0.68rem]">
                      {item}
                    </span>
                  ))
                }
              </div>

              <div class="mt-8">
                <a
                  href="https://github.com/dhioanugrah/borneo-endemic-flora-efficientnetv2-classification"
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center rounded-full border border-current px-4 py-2 font-mono text-xs transition hover:bg-current hover:text-paper"
                >
                  Repository GitHub ↗
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- MOBILE -->
      <section id="mobile" class="section-line">
        <div class="container-main py-20 md:py-28">
          <div class="grid gap-10 md:grid-cols-[0.45fr_1fr]">
            <p class="label">03 / Aplikasi Mobile</p>

            <div>
              <h2 class="text-4xl font-medium tracking-[-0.05em] md:text-6xl">
                Backend yang terhubung ke aplikasi mobile.
              </h2>

              <p class="mt-6 max-w-2xl leading-relaxed text-muted">
                Selain membangun API, saya juga memiliki pengalaman
                menghubungkan backend Laravel dengan aplikasi Flutter untuk
                kebutuhan pengguna di lapangan.
              </p>

              <div class="mt-14 grid gap-10 md:grid-cols-2">
                {
                  mobileProjects.map((project) => (
                    <article>
                      <div class="overflow-hidden rounded-[2rem] border border-line bg-ink p-2">
                        <img
                          src={project.image}
                          alt={project.title}
                          class="aspect-[9/12] w-full rounded-[1.55rem] object-cover"
                        />
                      </div>

                      <p class="label mt-6">{project.client}</p>

                      <h3 class="mt-3 text-2xl font-medium tracking-[-0.04em]">
                        {project.title}
                      </h3>

                      <p class="mt-2 font-mono text-xs text-accent">
                        {project.context}
                      </p>

                      <p class="mt-4 text-sm leading-relaxed text-muted">
                        {project.description}
                      </p>

                      <div class="mt-5 flex flex-wrap gap-2">
                        {project.tech.map((item) => (
                          <span class="border border-line px-3 py-1 font-mono text-[0.68rem]">
                            {item}
                          </span>
                        ))}
                      </div>

                      {project.links && (
                        <div class="mt-6 flex flex-wrap gap-3">
                          {project.links.map((link) => (
                            <a
                              href={link.href}
                              target="_blank"
                              rel="noreferrer"
                              class="inline-flex items-center rounded-full border border-ink px-4 py-2 font-mono text-xs text-ink transition hover:bg-ink hover:text-paper"
                            >
                              {link.label} ↗
                            </a>
                          ))}
                        </div>
                      )}
                    </article>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- OTHER PROJECTS -->
      <section class="section-line">
        <div class="container-main py-20 md:py-28">
          <div class="grid gap-10 md:grid-cols-[0.45fr_1fr]">
            <div>
              <p class="label">04 / Project Lainnya</p>
              <h2
                class="mt-4 text-4xl font-medium tracking-[-0.05em] md:text-5xl"
              >
                Pengalaman di berbagai kebutuhan digital.
              </h2>
            </div>

            <div>
              {
                otherProjects.map((project, index) => (
                  <article class="border-t border-line py-7">
                    <div class="flex items-start justify-between gap-6">
                      <div>
                        <p class="font-mono text-xs text-accent">
                          0{index + 1}
                        </p>

                        <h3 class="mt-3 text-2xl font-medium tracking-[-0.04em]">
                          {project.title}
                        </h3>

                        <p class="mt-2 font-mono text-xs text-muted">
                          {project.context}
                        </p>
                      </div>
                    </div>

                    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted">
                      {project.description}
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                      {project.tech.map((item) => (
                        <span class="border border-line px-3 py-1 font-mono text-[0.68rem]">
                          {item}
                        </span>
                      ))}
                    </div>

