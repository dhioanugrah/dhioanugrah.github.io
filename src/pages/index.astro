    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector("#theme-toggle");
        const navLinks = [...document.querySelectorAll(".nav-link")];

        function applyTheme(theme) {
          root.dataset.theme = theme;
          localStorage.setItem("dhio-theme", theme);

          const isDark = theme === "dark";

          toggle?.setAttribute(
            "aria-label",
            isDark ? "Aktifkan mode terang" : "Aktifkan mode gelap",
          );

          toggle?.setAttribute(
            "title",
            isDark ? "Aktifkan mode terang" : "Aktifkan mode gelap",
          );
        }

        applyTheme(root.dataset.theme === "light" ? "light" : "dark");

        toggle?.addEventListener("click", () => {
          const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";

          applyTheme(nextTheme);
        });

        navLinks.forEach((link) => {
          link.addEventListener("click", () => {
            navLinks.forEach((item) => item.classList.remove("is-active"));
            link.classList.add("is-active");
          });
        });

        // Mobile Menu Logic
        const menuBtn = document.getElementById("mobile-menu-btn");
        const menuOverlay = document.getElementById("mobile-menu-overlay");
        const menuLines = menuBtn?.querySelectorAll("span");
        let isMenuOpen = false;

        menuBtn?.addEventListener("click", () => {
          isMenuOpen = !isMenuOpen;
          if (isMenuOpen) {
            menuOverlay.classList.remove("pointer-events-none", "opacity-0", "invisible");
            menuOverlay.classList.add("opacity-100");
            if (menuLines) {
              menuLines[0].style.transform = "translateY(2.75px) rotate(45deg)";
              menuLines[1].style.transform =
                "translateY(-2.75px) rotate(-45deg)";
            }
            document.body.style.overflow = "hidden";
          } else {
            menuOverlay.classList.add("pointer-events-none", "opacity-0", "invisible");
            menuOverlay.classList.remove("opacity-100");
            if (menuLines) {
              menuLines[0].style.transform = "none";
              menuLines[1].style.transform = "none";
            }
            document.body.style.overflow = "";
          }
        });

        menuOverlay?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            menuBtn?.click();
          });
        });

        const sections = navLinks
          .map((link) => {
            const target = link.getAttribute("href");
            // Only observe links that point to an ID on the current page
            if (target && target.startsWith("#")) {
              return document.querySelector(target);
            }
            return null;
          })
          .filter(Boolean);

        const observer = new IntersectionObserver(
          (entries) => {
            const visibleSection = entries
              .filter((entry) => entry.isIntersecting)
              .sort(
                (first, second) =>
                  second.intersectionRatio - first.intersectionRatio,
              )[0];

            if (!visibleSection) return;

            navLinks.forEach((link) => {
              link.classList.toggle(
                "is-active",
                link.getAttribute("href") === `#${visibleSection.target.id}`,
              );
            });
          },
          {
            rootMargin: "-35% 0px -55% 0px",
            threshold: [0.01, 0.25, 0.5],
          },
        );

        sections.forEach((section) => observer.observe(section));
      })();
    </script>

    <!-- Lenis Smooth Scroll -->
    <script
      is:inline
      src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"
    ></script>

    <!-- GSAP -->
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"
    ></script>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // Initialize GSAP ScrollTrigger
        gsap.registerPlugin(ScrollTrigger);

        // Initialize Lenis
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smooth: true,
        });

        // Sync Lenis scroll with GSAP ScrollTrigger
        lenis.on("scroll", ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);

        // Hero Reveal
        gsap.fromTo(
          ".gsap-hero-reveal",
          { y: 50, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 1,
            stagger: 0.2,
            ease: "power3.out",
            delay: 0.2,
          },
        );

        // Section Title Reveal
        gsap.utils.toArray(".gsap-section-title").forEach((title) => {
          gsap.fromTo(
            title,
            { y: 50, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 1,
              ease: "power3.out",
              scrollTrigger: {
                trigger: title,
                start: "top 85%",
              },
            },
          );
        });

        // Project Reveal
        gsap.utils.toArray(".gsap-project-reveal").forEach((project) => {
          gsap.fromTo(
            project,
            { y: 60, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 1,
              ease: "power3.out",
              scrollTrigger: {
                trigger: project,
                start: "top 85%",
              },
            },
          );
        });
      });

      // --- CV Modal Lightbox Logic ---
      const cvImages = [
        "/cv-1.jpg", // Ganti dengan path gambar CV halaman 1
        "/cv-2.jpg"  // Ganti dengan path gambar CV halaman 2
      ];

      let currentCvSlideIndex = 0;
      let isCvZoomed = false;

      window.openCvModal = () => {
        const cvModal = document.getElementById('cv-modal');
        currentCvSlideIndex = 0;
        updateCvModalContent();
        
        cvModal.classList.remove('hidden');
        cvModal.classList.add('flex');
        // trigger reflow
        void cvModal.offsetWidth;
        cvModal.classList.remove('opacity-0');
        cvModal.classList.add('opacity-100');
        
        // Prevent body scroll
        document.body.style.overflow = 'hidden';
        
        // Reset zoom
        if(isCvZoomed) toggleCvZoom();
      };

      window.closeCvModal = () => {
        const cvModal = document.getElementById('cv-modal');
        cvModal.classList.remove('opacity-100');
        cvModal.classList.add('opacity-0');
        setTimeout(() => {
          cvModal.classList.remove('flex');
          cvModal.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      };

      window.updateCvModalContent = () => {
        const cvModalImage = document.getElementById('cv-modal-image');
        const cvModalSubtitle = document.getElementById('cv-modal-subtitle');
        const cvDotsContainer = document.getElementById('cv-modal-dots');

        cvModalSubtitle.textContent = `Halaman ${currentCvSlideIndex + 1}`;
        cvModalImage.src = cvImages[currentCvSlideIndex];
        
        // Update dots
        cvDotsContainer.innerHTML = '';
        cvImages.forEach((_, i) => {
          const dot = document.createElement('button');
          dot.className = `w-2 h-2 rounded-full transition-all ${i === currentCvSlideIndex ? 'bg-accent scale-125' : 'bg-line hover:bg-muted'}`;
          dot.onclick = (e) => {
            e.stopPropagation();
            currentCvSlideIndex = i;
            if(isCvZoomed) toggleCvZoom();
            updateCvModalContent();
          };
          cvDotsContainer.appendChild(dot);
        });
      };

      window.prevCvSlide = (e) => {
        if(e) e.stopPropagation();
        if(isCvZoomed) toggleCvZoom();
        currentCvSlideIndex = (currentCvSlideIndex - 1 + cvImages.length) % cvImages.length;
        updateCvModalContent();
      };

      window.nextCvSlide = (e) => {
        if(e) e.stopPropagation();
        if(isCvZoomed) toggleCvZoom();
        currentCvSlideIndex = (currentCvSlideIndex + 1) % cvImages.length;
        updateCvModalContent();
      };

      window.toggleCvZoom = () => {
        const cvModalImage = document.getElementById('cv-modal-image');
        const cvImgContainer = document.getElementById('cv-modal-img-container');

        isCvZoomed = !isCvZoomed;
        if (isCvZoomed) {
          cvModalImage.style.maxHeight = 'none';
          cvModalImage.style.maxWidth = 'none';
          cvModalImage.style.width = '150%';
          
          cvImgContainer.classList.remove('cursor-zoom-in', 'items-center', 'justify-center');
          cvImgContainer.classList.add('cursor-zoom-out', 'items-start', 'justify-start');
        } else {
          cvModalImage.style.maxHeight = '60vh';
          cvModalImage.style.maxWidth = '100%';
          cvModalImage.style.width = 'auto';
          
          cvImgContainer.classList.add('cursor-zoom-in', 'items-center', 'justify-center');
          cvImgContainer.classList.remove('cursor-zoom-out', 'items-start', 'justify-start');
        }
      };

      // Close on escape key or right/left arrows
      document.addEventListener('keydown', (e) => {
        const cvModal = document.getElementById('cv-modal');
        if (cvModal && cvModal.classList.contains('flex')) {
          if (e.key === 'Escape') closeCvModal();
          if (e.key === 'ArrowRight') nextCvSlide();
          if (e.key === 'ArrowLeft') prevCvSlide();
        }
      });
    </script>

